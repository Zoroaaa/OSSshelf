{
  "name": "api",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy:worker": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply ossshelf-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply ossshelf-db --local",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@cloudflare/ai-chat": "0.12.2",
    "@osshelf/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.20",
    "agents": "0.31.0",
    "ai": "7.0.156",
    "drizzle-orm": "^0.29.0",
    "hono": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261029.1",
    "drizzle-kit": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.155.0"
  }
